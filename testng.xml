<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Voice Banking API Suite" verbose="1">

    <listeners>
        <listener class-name="com.voicebanking.listeners.TestListener"/>
    </listeners>

    <test name="API Tests">
        <classes>

            <class name="com.voicebanking.tests.api.API1_GetAccountListTest"/>
            <class name="com.voicebanking.tests.api.API2_GetCustomerInfoTest"/>
            <class name="com.voicebanking.tests.api.API3_GetAccountBalanceTest"/>
            <class name="com.voicebanking.tests.api.API4_GetBeneficiariesListTest"/>
            <class name="com.voicebanking.tests.api.API5_GetTransactionsListTest"/>
            <class name="com.voicebanking.tests.api.API6_TransferMoneyTest"/>
            <class name="com.voicebanking.tests.api.API8_GetLoanStatementTest"/>
            <class name="com.voicebanking.tests.api.API9_GetLoanOverdueDetailsTest"/>
            <class name="com.voicebanking.tests.api.API10_GetLoanSummaryListTest"/>
        </classes>
    </test>

    <test name="UI Tests">
        <classes>
            <class name="com.voicebanking.tests.ui.UI1_WelcomePageTest"/>
            <class name="com.voicebanking.tests.ui.UI2_LoginTest"/>
            <class name="com.voicebanking.tests.ui.UI3_OtpTest"/>
            <class name="com.voicebanking.tests.ui.UI4_LanguageTest"/>
            <class name="com.voicebanking.tests.ui.UI5_VoiceRegistrationTest"/>
            <class name="com.voicebanking.tests.ui.UI6_HomePageTest"/>
        </classes>
    </test>

</suite>